<meta charset="UTF-8">

<meta name="viewport"
   content="width=device-width, initial-scale=1.0">

<title>Portal Cube - Jeu 3D</title>

<style>

* {
    box-sizing: border-box;
}

html,
body {

    margin: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #050713;

    font-family: Arial, sans-serif;
}

#game {

    position: fixed;

    inset: 0;
}


/* =====================================================
   MENU NOM
===================================================== */

#nameMenu {

    position: fixed;

    inset: 0;

    display: flex;

    justify-content: center;

    align-items: center;

    background:
        rgba(0, 0, 0, 0.8);

    z-index: 100;
}

#nameBox {

    width: 330px;

    padding: 25px;

    border-radius: 15px;

    background: #151925;

    color: white;

    text-align: center;

    box-shadow:
        0 15px 50px
        rgba(0, 0, 0, 0.7);
}

#nameBox h2 {

    margin-top: 0;

    margin-bottom: 10px;
}

#nameInput {

    width: 100%;

    padding: 12px;

    border: none;

    outline: none;

    border-radius: 8px;

    font-size: 16px;

    margin-bottom: 10px;
}

#playButton {

    width: 100%;

    padding: 12px;

    border: none;

    border-radius: 8px;

    background: #3978ff;

    color: white;

    font-size: 16px;

    cursor: pointer;
}

#playButton:hover {

    background: #5b91ff;
}


/* =====================================================
   INTERFACE
===================================================== */

#ui {

    position: fixed;

    top: 15px;

    left: 15px;

    padding: 15px;

    border-radius: 10px;

    background:
        rgba(0, 0, 0, 0.7);

    color: white;

    z-index: 10;

    user-select: none;
}

#status {

    margin-top: 8px;

    font-size: 14px;
}

#controls {

    position: fixed;

    bottom: 20px;

    left: 20px;

    padding: 12px;

    border-radius: 10px;

    background:
        rgba(0, 0, 0, 0.7);

    color: white;

    z-index: 10;

    user-select: none;
}

</style>

</head>

<body>

<div id="game"></div>

<!-- =====================================================
     MENU
===================================================== -->

<div id="nameMenu">

```
<div id="nameBox">

    <h2>🧊 Portal Cube</h2>

    <p>
        Choisis ton nom temporaire
    </p>

    <input
        id="nameInput"
        maxlength="16"
        placeholder="Ton nom..."
        autocomplete="off"
    >

    <button id="playButton">
        Jouer
    </button>

</div>
```

</div>

<!-- =====================================================
     UI
===================================================== -->

<div id="ui">


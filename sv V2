                                token:token

                            })}\n\n`

                        );


                    }



                }

                catch{}

            }



        }





        // Ajout réponse IA

        history.push({

            role:"assistant",

            content:
            fullAnswer

        });





        res.end();



    }

    catch(error){


        console.error(error);



        res.status(500).json({

            reply:
            "Erreur IA : "+error.message

        });


    }



});






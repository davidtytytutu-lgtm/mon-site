```

</div>

<script type="module">


// =====================================================
// THREE.JS
// =====================================================

import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js";


import { GLTFLoader } from
"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/loaders/GLTFLoader.js";


// =====================================================
// URL DU MODÈLE
// =====================================================

const MODEL_URL =
"https://cdn.jsdelivr.net/gh/davidtytytutu-lgtm/mon-site@refs/heads/main/portal_cube.glb";


// =====================================================
// URL SERVEUR
// =====================================================

const SERVER_URL =
"https://trail-space-countries-nobody.trycloudflare.com";


// =====================================================
// SCÈNE
// =====================================================

const scene =
new THREE.Scene();


scene.background =
new THREE.Color(
    0x070b1a
);


// =====================================================
// CAMÉRA
// =====================================================

const camera =
new THREE.PerspectiveCamera(

    75,

    window.innerWidth /
    window.innerHeight,

    0.1,

    1000

);


camera.position.set(
    0,
    7,
    10
);


// =====================================================
// RENDERER
// =====================================================

const renderer =
new THREE.WebGLRenderer({

    antialias: true

});


renderer.setSize(

    window.innerWidth,

    window.innerHeight

);


renderer.setPixelRatio(

    Math.min(
        window.devicePixelRatio,
        2
    )

);


document
.getElementById("game")
.appendChild(
    renderer.domElement
);


// =====================================================
// LUMIÈRES
// =====================================================

const ambientLight =
new THREE.AmbientLight(

    0x667799,

    0.8

);


scene.add(
    ambientLight
);


const moonLight =
new THREE.DirectionalLight(

    0xaabbff,

    1.5

);


moonLight.position.set(

    10,
    20,
    10

);


scene.add(
    moonLight
);


// =====================================================
// MAP
// =====================================================

const MAP_SIZE = 50;

const HALF_MAP =
MAP_SIZE / 2;


// =====================================================
// SOL
// =====================================================

const groundGeometry =
new THREE.BoxGeometry(

    MAP_SIZE,
    0.5,
    MAP_SIZE

);


const groundMaterial =
new THREE.MeshStandardMaterial({

    color: 0x252b35,

    roughness: 1

});


const ground =
new THREE.Mesh(

    groundGeometry,

    groundMaterial

);


ground.position.y =
-0.25;


scene.add(
    ground
);


// =====================================================
// GRILLE
// =====================================================

const grid =
new THREE.GridHelper(

    MAP_SIZE,

    25,

    0x596273,

    0x343a47

);


grid.position.y =
0.01;


scene.add(
    grid
);


// =====================================================
// HITBOX
// =====================================================

const hitboxGeometry =
new THREE.BoxGeometry(

    1,
    1,
    1

);


// =====================================================
// MODÈLE GLB
// =====================================================

let modelTemplate =
null;


const loader =
new GLTFLoader();


loader.load(

    MODEL_URL,

    (gltf) => {

        modelTemplate =
            gltf.scene;

        console.log(
            "Modèle GLB chargé !"
        );

        console.log(
            modelTemplate
        );

    },

    (progress) => {

        if (
            progress.total > 0
        ) {

            const percent =
                Math.round(
                    progress.loaded /
                    progress.total *
                    100
                );

            console.log(
                "Chargement modèle :",
                percent + "%"
            );
        }

    },

    (error) => {

        console.error(
            "Erreur chargement GLB :",
            error
        );

    }

);


// =====================================================
// CRÉATION DU MODÈLE
// =====================================================

function createPlayerModel() {

    if (!modelTemplate) {
        return null;
    }

    const model =
        modelTemplate.clone(true);

    // -----------------------------------------
    // Calcul de la taille originale du modèle
    // -----------------------------------------

    const box =
        new THREE.Box3()
            .setFromObject(model);

    const size =
        new THREE.Vector3();

    box.getSize(size);


    // -----------------------------------------
    // On prend la plus grande dimension
    // -----------------------------------------

    const maxSize =
        Math.max(
            size.x,
            size.y,
            size.z
        );


    // -----------------------------------------
    // Le modèle devient 1 unité de hauteur/taille
    // -----------------------------------------

    if (maxSize > 0) {

        const scale =
            1 / maxSize;

        model.scale.set(
            scale,
            scale,
            scale
        );
    }


    // -----------------------------------------
    // Recalcul de la boîte après resize
    // -----------------------------------------

    const resizedBox =
        new THREE.Box3()
            .setFromObject(model);


    const center =
        new THREE.Vector3();


    resizedBox.getCenter(center);


    // Centrer le modèle dans la hitbox
    model.position.x -=
        center.x;


    model.position.y -=
        center.y;


    model.position.z -=
        center.z;


    return model;
}


// =====================================================
// JOUEUR LOCAL
// =====================================================

const player =
new THREE.Group();


player.position.set(

    0,
    0.5,
    0

);


scene.add(
    player
);


// Hitbox invisible
const playerHitbox =
new THREE.Mesh(

    hitboxGeometry,

    new THREE.MeshBasicMaterial({

        visible: false

    })

);


player.add(
    playerHitbox
);


// =====================================================
// AJOUT DU MODÈLE QUAND IL EST CHARGÉ
// =====================================================

const waitForModel =
setInterval(

    () => {

        if (
            modelTemplate
        ) {

            clearInterval(
                waitForModel
            );


            const model =
                createPlayerModel();


            if (model) {

                player.add(
                    model
                );

            }

        }

    },

    100

);


// =====================================================
// JOUEURS DISTANTS
// =====================================================

const otherPlayers = {};


// =====================================================
// NOM 3D
// =====================================================

function createNameLabel(
    name
) {

    const canvas =
        document.createElement(
            "canvas"
        );


    canvas.width =
        512;


    canvas.height =
        128;


    const ctx =
        canvas.getContext(
            "2d"
        );


    ctx.clearRect(

        0,
        0,
        canvas.width,
        canvas.height

    );


    ctx.font =
        "bold 52px Arial";


    ctx.textAlign =
        "center";


    ctx.textBaseline =
        "middle";


    ctx.lineWidth =
        8;


    ctx.strokeStyle =
        "black";


    ctx.fillStyle =
        "white";


    ctx.strokeText(

        name,

        canvas.width / 2,

        canvas.height / 2

    );


    ctx.fillText(

        name,

        canvas.width / 2,

        canvas.height / 2

    );


    const texture =
        new THREE.CanvasTexture(
            canvas
        );


    const material =
        new THREE.SpriteMaterial({

            map: texture,

            transparent: true

        });


    const sprite =
        new THREE.Sprite(
            material
        );


    sprite.scale.set(

        3,
        0.75,
        1

    );


    sprite.position.y =
        1.3;


    return sprite;

}


// =====================================================
// TOUCHES
// =====================================================

const keys = {};


window.addEventListener(

    "keydown",

    event => {

        keys[
            event.key.toLowerCase()
        ] = true;


        if (

            event.code ===
            "Space" ||

            event.key.startsWith(
                "Arrow"
            )

        ) {

            event.preventDefault();

        }

    }

);


window.addEventListener(

    "keyup",

    event => {

        keys[
            event.key.toLowerCase()
        ] = false;

    }

);


// =====================================================
// PHYSIQUE
// =====================================================

let velocityY =
0;


const GRAVITY =
-18;


const JUMP_FORCE =
8;


let isGrounded =
true;


// =====================================================
// SERVEUR
// =====================================================

let socket =
null;


let myId =
null;


let playerName =
"Joueur";


// =====================================================
// CONNEXION
// =====================================================

function connectServer() {

    socket =
        new WebSocket(
            SERVER_URL
        );


    socket.addEventListener(

        "open",

        () => {

            document
            .getElementById(
                "status"
            )
            .textContent =
                "🟢 Connecté";


            socket.send(

                JSON.stringify({

                    type: "name",

                    name:
                        playerName

                })

            );

        }

    );


    socket.addEventListener(

        "message",

        event => {

            try {

                const data =
                    JSON.parse(
                        event.data
                    );


                if (
                    data.type ===
                    "id"
                ) {

                    myId =
                        data.id;

                }


                if (
                    data.type ===
                    "players"
                ) {

                    updatePlayers(
                        data.players
                    );

                }

            }

            catch (
                error
            ) {

                console.error(
                    error
                );

            }

        }

    );


    socket.addEventListener(

        "close",

        () => {

            document
            .getElementById(
                "status"
            )
            .textContent =
                "🔴 Déconnecté";

        }

    );


    socket.addEventListener(

        "error",

        () => {

            document
            .getElementById(
                "status"
            )
            .textContent =
                "❌ Erreur serveur";

        }

    );

}


// =====================================================
// JOUEURS DISTANTS
// =====================================================

function createRemotePlayer(
    data
) {

    const group =
        new THREE.Group();


    group.position.set(

        data.x,
        data.y,
        data.z

    );


    // Hitbox
    const hitbox =
        new THREE.Mesh(

            hitboxGeometry,

            new THREE.MeshBasicMaterial({

                visible: false

            })

        );


    group.add(
        hitbox
    );


    // Modèle
    if (
        modelTemplate
    ) {

        const model =
            createPlayerModel();


        if (model) {

            group.add(
                model
            );

        }

    }


    // Nom
    const label =
        createNameLabel(
            data.name
        );


    group.add(
        label
    );


    scene.add(
        group
    );


    return {

        group:
            group,

        label:
            label,

        name:
            data.name

    };

}


// =====================================================
// MISE À JOUR JOUEURS
// =====================================================

function updatePlayers(
    players
) {


    for (
        const id in players
    ) {


        if (
            id === myId
        ) {

            continue;

        }


        const data =
            players[id];


        if (
            !otherPlayers[id]
        ) {

            otherPlayers[id] =
                createRemotePlayer(
                    data
                );

        }


        const other =
            otherPlayers[id];


        other.group.position.set(

            data.x,
            data.y,
            data.z

        );


        // Mise à jour du nom
        if (
            other.name !==
            data.name
        ) {

            other.group.remove(
                other.label
            );


            other.label =
                createNameLabel(
                    data.name
                );


            other.group.add(
                other.label
            );


            other.name =
                data.name;

        }

    }


    // Suppression
    for (
        const id in otherPlayers
    ) {

        if (
            !players[id]
        ) {

            scene.remove(
                otherPlayers[id].group
            );


            delete
                otherPlayers[id];

        }

    }

}


// =====================================================
// COLLISIONS
// =====================================================

function checkPlayerCollisions() {

    const my =
        player.position;


    for (
        const id in otherPlayers
    ) {


        const other =
            otherPlayers[id].group;


        const dx =
            my.x -
            other.position.x;


        const dy =
            my.y -
            other.position.y;


        const dz =
            my.z -
            other.position.z;


        const overlapX =
            1 -
            Math.abs(dx);


        const overlapY =
            1 -
            Math.abs(dy);


        const overlapZ =
            1 -
            Math.abs(dz);


        if (

            overlapX <= 0 ||

            overlapY <= 0 ||

            overlapZ <= 0

        ) {

            continue;

        }


        // =========================================
        // TOMBER SUR LA TÊTE
        // =========================================

        if (

            velocityY <= 0 &&

            my.y >
            other.position.y

        ) {


            const otherTop =
                other.position.y +
                0.5;


            const myBottom =
                my.y -
                0.5;


            if (

                myBottom <=
                otherTop &&

                myBottom >=
                other.position.y -
                0.5

            ) {


                my.y =
                    otherTop +
                    0.5;


                velocityY =
                    0;


                isGrounded =
                    true;


                continue;

            }

        }


        // =========================================
        // COLLISION LATÉRALE
        // =========================================

        if (

            Math.abs(dy) <
            0.9

        ) {


            if (
                overlapX <
                overlapZ
            ) {


                if (
                    dx > 0
                ) {

                    my.x +=
                        overlapX;

                }

                else {

                    my.x -=
                        overlapX;

                }

            }

            else {


                if (
                    dz > 0
                ) {

                    my.z +=
                        overlapZ;

                }

                else {

                    my.z -=
                        overlapZ;

                }

            }

        }

    }

}


// =====================================================
// SAUT
// =====================================================

function jump() {

    if (
        isGrounded
    ) {

        velocityY =
            JUMP_FORCE;


        isGrounded =
            false;

    }

}


window.addEventListener(

    "keydown",

    event => {

        if (

            event.code ===
            "Space" &&

            !event.repeat

        ) {

            jump();

        }

    }

);


// =====================================================
// POSITION SERVEUR
// =====================================================

let lastSend =
0;


function sendPosition() {

    if (

        socket &&

        socket.readyState ===
        WebSocket.OPEN

    ) {


        socket.send(

            JSON.stringify({

                type:
                    "position",

                x:
                    player.position.x,

                y:
                    player.position.y,

                z:
                    player.position.z

            })

        );

    }

}


// =====================================================
// DÉPLACEMENT
// =====================================================

function updatePlayer(
    delta
) {


    const speed =
        5;


    let moveX =
        0;


    let moveZ =
        0;


    if (

        keys["z"] ||
        keys["w"] ||
        keys["arrowup"]

    ) {

        moveZ--;

    }


    if (

        keys["s"] ||
        keys["arrowdown"]

    ) {

        moveZ++;

    }


    if (

        keys["q"] ||
        keys["a"] ||
        keys["arrowleft"]

    ) {

        moveX--;

    }


    if (

        keys["d"] ||
        keys["arrowright"]

    ) {

        moveX++;

    }


    const length =
        Math.sqrt(

            moveX *
            moveX +

            moveZ *
            moveZ

        );


    if (
        length > 0
    ) {

        moveX /=
            length;


        moveZ /=
            length;


        player.position.x +=

            moveX *
            speed *
            delta;


        player.position.z +=

            moveZ *
            speed *
            delta;

    }


    // Gravité
    velocityY +=
        GRAVITY *
        delta;


    player.position.y +=
        velocityY *
        delta;


    // Sol
    if (

        player.position.y <=
        0.5

    ) {

        player.position.y =
            0.5;


        velocityY =
            0;


        isGrounded =
            true;

    }


    // Limites
    player.position.x =
        THREE.MathUtils.clamp(

            player.position.x,

            -HALF_MAP +
            0.5,

            HALF_MAP -
            0.5

        );


    player.position.z =
        THREE.MathUtils.clamp(

            player.position.z,

            -HALF_MAP +
            0.5,

            HALF_MAP -
            0.5

        );


    // Collision joueurs
    checkPlayerCollisions();


    // Envoi serveur
    const now =
        Date.now();


    if (

        now -
        lastSend >
        50

    ) {

        sendPosition();


        lastSend =
            now;

    }

}


// =====================================================
// CAMÉRA
// =====================================================

function updateCamera() {

    camera.position.x =
        player.position.x;


    camera.position.z =
        player.position.z +
        10;


    camera.position.y =
        player.position.y +
        7;


    camera.lookAt(

        player.position.x,

        player.position.y,

        player.position.z

    );

}


// =====================================================
// BOUCLE
// =====================================================

const clock =
    new THREE.Clock();


function animate() {


    requestAnimationFrame(
        animate
    );


    const delta =
        Math.min(

            clock.getDelta(),

            0.05

        );


    updatePlayer(
        delta
    );


    updateCamera();


    renderer.render(

        scene,

        camera

    );

}


animate();


// =====================================================
// MENU NOM
// =====================================================

const nameInput =
    document.getElementById(
        "nameInput"
    );


const playButton =
    document.getElementById(
        "playButton"
    );


function startGame() {


    let name =
        nameInput.value.trim();


    if (!name) {

        name =
            "Joueur";

    }


    playerName =
        name.substring(
            0,
            16
        );


    document
    .getElementById(
        "nameMenu"
    )
    .style.display =
        "none";


    connectServer();

}


playButton.addEventListener(

    "click",

    startGame

);


nameInput.addEventListener(

    "keydown",

    event => {

        if (
            event.key ===
            "Enter"
        ) {

            startGame();

        }

    }

);


// =====================================================
// REDIMENSIONNEMENT
// =====================================================

window.addEventListener(

    "resize",

    () => {

        camera.aspect =

            window.innerWidth /
            window.innerHeight;


        camera.updateProjectionMatrix();


        renderer.setSize(

            window.innerWidth,

            window.innerHeight

        );

    }

);

</script>

</body>

</html>

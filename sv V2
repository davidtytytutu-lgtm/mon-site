        let fullAnswer = "";



        const reader =
        response.body.getReader();



        const decoder =
        new TextDecoder();




        while(true){


            const {

                done,

                value

            } =
            await reader.read();



            if(done)
                break;




            const chunk =
            decoder.decode(value);





            const lines =
            chunk.split("\n");





            for(const line of lines){


                if(!line.trim())
                    continue;




                try{


                    const json =
                    JSON.parse(line);





                    if(json.message?.content){



                        const token =
                        json.message.content;



                        fullAnswer += token;




                        res.write(


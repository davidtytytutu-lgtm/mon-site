<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>NodeChat</title>

<style>

*{
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{

    margin:0;
    height:100vh;
    background:#111827;
    color:white;

    display:flex;
    justify-content:center;
    align-items:center;

}


.container{

    width:90%;
    max-width:900px;
    height:90vh;

    background:#1f2937;

    border-radius:20px;

    display:flex;
    flex-direction:column;

    overflow:hidden;

    box-shadow:0 0 30px #0008;

}


/* HEADER */

.header{

    padding:20px;

    background:#111827;

    display:flex;
    justify-content:space-between;
    align-items:center;

}


.header h1{

    margin:0;

    font-size:28px;

}


#status{

    background:#374151;

    padding:8px 15px;

    border-radius:20px;

    font-size:14px;

}



/* USER */

.user{

    padding:15px;

    background:#374151;

}


.user input{

    background:#111827;

    color:white;

    border:none;

    padding:10px;

    border-radius:10px;

    outline:none;

}



/* CHAT */

#chat{

    flex:1;

    overflow-y:auto;

    padding:20px;

}



/* MESSAGE */

.message{

    background:#374151;

    padding:12px;

    margin-bottom:10px;

    border-radius:15px;

    width:fit-content;

    max-width:80%;

}


.message small{

    color:#9ca3af;

    margin-left:10px;

}



/* INPUT */

.bottom{

    display:flex;

    gap:10px;

    padding:15px;

    background:#111827;

}


#message{

    flex:1;

    padding:15px;

    border-radius:15px;

    border:none;

    outline:none;

    background:#374151;

    color:white;

}



button{

    padding:15px 25px;

    border:none;

    border-radius:15px;

    background:#2563eb;

    color:white;

    cursor:pointer;

    font-weight:bold;

}


button:hover{

    background:#1d4ed8;

}


</style>

</head>


<body>


<div class="container">


<div class="header">

<h1>💬 NodeChat</h1>

<p id="status">Connexion...</p>

</div>



<div class="user">

Pseudo :

<input id="pseudo" value="Invité">

</div>



<div id="chat">


</div>



<div class="bottom">

<input id="message" placeholder="Votre message...">

<button onclick="envoyer()">
Envoyer
</button>

</div>


</div>



<script>


const URL = "https://soup-comply-transit-accessories.trycloudflare.com";

let ws;

const chat = document.getElementById("chat");
const status = document.getElementById("status");



function ajouterMessage(message,date){


let heure="";


if(date){

heure=new Date(date).toLocaleTimeString("fr-FR",{
hour:"2-digit",
minute:"2-digit"
});

}



chat.innerHTML += `

<div class="message">

${message}

${heure ? "<small>"+heure+"</small>" : ""}

</div>

`;


chat.scrollTop=chat.scrollHeight;


}




function connecter(){


ws=new WebSocket(URL);



ws.onopen=()=>{

status.innerHTML="🟢 Connecté";

};



ws.onclose=()=>{

status.innerHTML="🔴 Déconnecté";

setTimeout(connecter,2000);

};



ws.onerror=()=>{

console.log("Erreur WebSocket");

};



ws.onmessage=(event)=>{


let packet=JSON.parse(event.data);



if(packet.type==="history"){


chat.innerHTML="";


packet.data.forEach(message=>{

ajouterMessage(message.text,message.date);

});


}



if(packet.type==="message"){


ajouterMessage(packet.data.text,packet.data.date);


}



};


}



connecter();





function envoyer(){


if(ws.readyState!==WebSocket.OPEN){

alert("Pas connecté au serveur");

return;

}



let pseudo=document.getElementById("pseudo").value.trim();

let message=document.getElementById("message").value.trim();



if(message==="") return;



ws.send("<b>"+pseudo+"</b> : "+message);



document.getElementById("message").value="";


}




document.getElementById("message").addEventListener("keydown",(e)=>{

if(e.key==="Enter"){

envoyer();

}

});



</script>


</body>
</html>

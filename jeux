<!DOCTYPE html>
<html lang="fr">
<head>

<meta charset="UTF-8">
<title>Jeu 2D Multijoueur</title>

<style>

body{
    margin:0;
    overflow:hidden;
    background:#87CEEB;
    font-family:Arial;
}


canvas{
    display:block;
}


/* HUB */

#hub{

position:absolute;

top:50%;
left:50%;

transform:translate(-50%,-50%);

background:white;

padding:30px;

border-radius:15px;

text-align:center;

box-shadow:0 0 20px #0005;

}


#hub h1{

margin-top:0;

}


input{

padding:10px;

font-size:18px;

width:200px;

}


button{

margin-top:15px;

padding:10px 40px;

font-size:18px;

cursor:pointer;

}

</style>

</head>


<body>


<div id="hub">

<h1>🌍 Jeu 2D</h1>

<p>Choisis ton pseudo</p>

<input id="name" placeholder="Pseudo">


<br>


<button id="play">
JOUER
</button>


</div>



<canvas id="game"></canvas>

<audio id="music" loop>
    <source src="https://github.com/davidtytytutu-lgtm/mon-site/raw/refs/heads/main/chill%20lobby.mp3" type="audio/mpeg">
</audio>

<script>


const canvas=document.getElementById("game");

const ctx=canvas.getContext("2d");



function resize(){

canvas.width=window.innerWidth;

canvas.height=window.innerHeight;

}


resize();

window.addEventListener("resize",resize);



// =====================
// SPRITES
// =====================


const spriteAvant=new Image();

spriteAvant.src=
"https://raw.githubusercontent.com/davidtytytutu-lgtm/mon-site/refs/heads/main/avant.png";



const spriteArriere=new Image();

spriteArriere.src=
"https://raw.githubusercontent.com/davidtytytutu-lgtm/mon-site/refs/heads/main/arriere.png";




// =====================
// WEBSOCKET
// =====================


const socket=new WebSocket(
"https://camcorder-passion-purchased-performing.trycloudflare.com/"
);



let myId=null;

let players={};

let pseudo="";




// =====================
// HUB
// =====================


const inputName=
document.getElementById("name");


const saved=
localStorage.getItem("pseudo");


if(saved){

inputName.value=saved;

}



document.getElementById("play").onclick=()=>{

const music = document.getElementById("music");

music.volume = 0.3;

music.play();

pseudo=inputName.value.trim();


if(pseudo==="")

pseudo="Joueur";



localStorage.setItem(
"pseudo",
pseudo
);



document.getElementById("hub").style.display="none";



if(socket.readyState===1){

socket.send(JSON.stringify({

type:"name",

name:pseudo

}));

}


};





socket.onopen=()=>{

console.log("Connexion serveur");

};





socket.onmessage=(event)=>{


const data=
JSON.parse(event.data);



switch(data.type){



case "init":


myId=data.id;

players=data.players;


break;



case "join":


players[data.player.id]=data.player;


break;



case "leave":


delete players[data.id];


break;



case "state":


players=data.players;


break;



}



};




// =====================
// CONTROLES
// =====================


const keys={

left:false,

right:false,

jump:false

};



window.addEventListener(
"keydown",
(e)=>{


if(e.code==="ArrowLeft")

keys.left=true;



if(e.code==="ArrowRight")

keys.right=true;



if(e.code==="ArrowUp" ||
e.code==="Space")

keys.jump=true;



});




window.addEventListener(
"keyup",
(e)=>{


if(e.code==="ArrowLeft")

keys.left=false;



if(e.code==="ArrowRight")

keys.right=false;



if(e.code==="ArrowUp" ||
e.code==="Space")

keys.jump=false;



});




// =====================
// ENVOI CONTROLES
// =====================


setInterval(()=>{


if(socket.readyState!==1)

return;



socket.send(JSON.stringify({

type:"input",

left:keys.left,

right:keys.right,

jump:keys.jump


}));



},1000/60);






// =====================
// DESSIN
// =====================


function draw(){



ctx.clearRect(
0,
0,
canvas.width,
canvas.height
);



// ciel

ctx.fillStyle="#87CEEB";

ctx.fillRect(
0,
0,
canvas.width,
canvas.height
);



// sol

ctx.fillStyle="#4CAF50";

ctx.fillRect(
0,
532,
canvas.width,
canvas.height
);



ctx.fillStyle="#795548";

ctx.fillRect(
0,
500,
canvas.width,
32
);





for(const id in players){


const p=players[id];



let img;



if(p.direction==="arriere")

img=spriteArriere;

else

img=spriteAvant;





// joueur

ctx.drawImage(

img,

p.x,

p.y-64,

64,

64

);




// pseudo

ctx.fillStyle="black";

ctx.font="16px Arial";

ctx.textAlign="center";


ctx.fillText(

p.name || "Joueur",

p.x+32,

p.y-75

);



}



}




function loop(){


draw();


requestAnimationFrame(loop);


}


loop();



</script>


</body>

</html>
